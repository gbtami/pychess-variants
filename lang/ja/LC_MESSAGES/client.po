msgstr ""

#: ../client/tournamentForm.ts:15
msgid ""
"You need the tournament permission in this team to create this tournament."
msgstr ""

#: ../client/tournamentForm.ts:17
msgid "Round-Robin and Swiss tournaments must belong to a team."
msgstr ""

#: ../client/tournamentForm.ts:19
msgid ""
